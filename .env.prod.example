# Copy to .env.prod and fill in. Never commit the real file (.env.* is git-ignored).
# Used by:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
POSTGRES_PASSWORD=
# The host name(s) people will type into the browser, comma separated.
ALLOWED_HOSTS=pillsync.example.com
FRONTEND_BASE_URL=https://pillsync.example.com

# --- Optional ---
POSTGRES_DB=pillsync
POSTGRES_USER=pillsync
WEB_PORT=80

# TLS is terminated in front of nginx in a real deployment. Set false ONLY to
# smoke-test the stack on a laptop over plain http.
USE_HTTPS=true

# Only needed when the SPA is served from a different origin than the API.
# CORS_ALLOWED_ORIGINS=https://app.pillsync.example.com
# CSRF_TRUSTED_ORIGINS=https://app.pillsync.example.com

# --- Email (reminders and caregiver alerts) ---
# Without a mail transport, reminders fail visibly and reset emails cannot be
# delivered. Set ONE of:
#   SendGrid:      SENDGRID_API_KEY=...          (host/user/port are filled in for you)
#   Any SMTP host: EMAIL_HOST=... EMAIL_PORT=587 EMAIL_HOST_USER=... EMAIL_HOST_PASSWORD=...
# SENDGRID_API_KEY=
# EMAIL_HOST=
DEFAULT_FROM_EMAIL=noreply@pillsync.example.com

# --- Tuning ---
WEB_CONCURRENCY=3
OCR_RETENTION_DAYS=30
REFILL_LEAD_TIME_DAYS=5

# Optional Google sign-in. The two IDs must match. Add your website origin to
# the Google OAuth application's authorized JavaScript origins.
GOOGLE_OAUTH2_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Firebase admin credentials: mount a service-account JSON file outside Git.
# FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
# Compose users: add the corresponding read-only mount to backend and worker.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATION_MAX_ATTEMPTS=3

# Per-user API rate limit. Leave the default for real use; raise it ONLY on a
# stack you are load testing (a limiter that answers 429 instantly makes every
# latency figure meaningless).
# THROTTLE_USER_RATE=5000/day
